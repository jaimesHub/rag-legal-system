# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Provider ---------------------------------------------------------------
# "gemini" for live calls, "fake" for deterministic offline runs (tests/smoke).
PROVIDER=gemini
GEMINI_API_KEY=

# Embedding. Changing EMBED_MODEL or EMBED_DIM implies a full re-index: the
# collection name is derived from both, so each pairing gets its own Qdrant
# collection and old vectors are never silently mixed in.
#   gemini-embedding-001 — supports task_type (asymmetric query/doc), 2048 tok
#   gemini-embedding-2   — newer, 8192 tok, no task_type
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_BATCH_SIZE=32

# Generation and judge. Keep the judge on a different model than the generator
# to reduce self-preference bias (used from T1 onward; declared here already).
GENERATOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-pro

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Optional override; default is derived as legal_<embed_model-or-fake-slug>_<dim>.
COLLECTION_NAME=

# --- Dataset (pinned; do not float to "main") --------------------------------
DATASET_REPO_ID=GreenNode/zalo-ai-legal-text-retrieval-vn
DATASET_REVISION=12d76d4d04b94ceada970fcfbe7fec20bfa97389

# --- Chunking -----------------------------------------------------------------
# "article" keeps one passage per Điều (matches how the corpus ships and how
# golden labels are keyed). "khoan" splits each Điều into its Khoản (T3+).
CHUNK_STRATEGY=article
CHUNK_MAX_CHARS=2400
CHUNK_MIN_CHARS=120
